# Copy to .env and set real values: cp .env.example .env
# NEVER commit .env or real credentials.

# Runtime
PORT=8000
NODE_ENV=production
# Set COOKIE_SECURE=true only when running behind HTTPS (reverse proxy/production TLS).
COOKIE_SECURE=false

# Required for admin access and sessions. Use long random values in shared/production deployments.
ADMIN_PASSWORD=change_me_to_a_long_random_admin_password
SESSION_SECRET=change_me_to_a_long_random_session_secret

# MongoDB Atlas (required for application runtime data)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=mahashree_namkeen

# Legacy/local fallbacks are NOT used by the MongoDB-only runtime. Keep data/orders.db as backup only.
# Migration scripts in scripts/ may read local SQLite backup; do not run migrations unless explicitly intended.
