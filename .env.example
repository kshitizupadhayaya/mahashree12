# Copy to .env for Docker/local config: cp .env.example .env
# Never commit .env or real credentials.

# App
PORT=8000
APP_URL=
NODE_ENV=production

# Required for admin access and sessions. Use long random values for real/shared deployments.
ADMIN_PASSWORD=change_me_admin_password
SESSION_SECRET=change_me_session_secret

# Database selection (app falls back to SQLite if MongoDB/MySQL is unavailable)
# 1) SQLite (default): leave MongoDB/MySQL blank. Docker persists ./app data in app_data volume.
# 2) MongoDB Atlas (preferred if you use Atlas): set MONGODB_URI to your Atlas connection string.
# 3) Local MongoDB container: docker compose --profile local-db up --build -d
#    and set MONGODB_URI=mongodb://mongo:27017/mahashree_namkeen
# 4) Local MySQL container: docker compose --profile local-db up --build -d
#    and set MYSQL_HOST=mysql, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE.

# MongoDB (optional / Atlas)
MONGODB_URI=
MONGODB_DB=mahashree_namkeen

# MySQL (optional)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Only needed when starting the optional local mysql service (--profile local-db)
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
